<Project Sdk="Microsoft.NET.Sdk">
  <!--
    netstandard2.0 on purpose: it is the only framework both launchers can load
    (the official one runs on CLR 4, PCL-CE on CoreCLR). Harmony therefore cannot
    be referenced at all - patches are declared and the host applies them.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>Example</AssemblyName>
    <RootNamespace>PclExamplePlugin</RootNamespace>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Nullable>disable</Nullable>
    <NoWarn>CS0618</NoWarn>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <!-- Private=false: the plugin never ships its own copy of the contract, the
         launcher already provides it. -->
    <ProjectReference Include="..\contract\PclHarmony.Contract.csproj" Private="false" />
  </ItemGroup>
</Project>
