<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>Example-Title</AssemblyName>
    <RootNamespace>PclExampleTitlePlugin</RootNamespace>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <UseWindowsForms>false</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <NoWarn>CS0618</NoWarn>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <!-- Same rule as the sample plugin: never ship a second copy of 0Harmony or
         PclHarmony, the identity has to stay identical to the loader's. -->
    <PackageReference Include="Lib.Harmony" Version="2.4.2" ExcludeAssets="runtime" />
    <ProjectReference Include="..\loader\PclHarmony.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>
</Project>
