# Normalise line endings so Windows contributors and CI agree.
* text=auto eol=crlf

# PowerShell and C# sources are text.
*.ps1   text eol=crlf
*.cs    text eol=crlf
*.csproj text eol=crlf
*.sln   text eol=crlf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
.gitattributes text eol=lf

# The launcher executables and compiled artefacts are binary.
*.exe   binary
*.dll   binary
*.pdb   binary
*.zip   binary
